# ARIA Environment Configuration Example
ARIA_ENV=development
ARIA_LOG_LEVEL=INFO
ARIA_CONFIG_PATH=config/config.yaml

# LLM Config
MODEL_PROVIDER=ollama
MODEL_NAME=gemma4:e2b
MODEL_TEMPERATURE=0.7
OLLAMA_HOST=http://localhost:11434

# Tool Service Config
SEARCH_PROVIDER=mock # mock, duckduckgo, google
SEARCH_API_KEY=
GOOGLE_CX=

WEATHER_PROVIDER=mock # mock, openmeteo
WEATHER_API_KEY=

MEMORY_DIR=./memory
CONVERSATIONS_FILE=conversations.json
